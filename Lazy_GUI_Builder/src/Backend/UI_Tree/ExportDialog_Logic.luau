--[[
Toggles the visibility state of the export dialog in AppState.

Returns:
    () -- No return value
]]
function ExportDialog_Logic.ToggleVisibility(): ()
	AppState.SessionState.IsExportDialogVisible = not AppState.SessionState.IsExportDialogVisible
end

--[[
Explicitly sets the visibility state of the export dialog in AppState.

Params:
    Visible: boolean -- Whether the dialog should be visible

Returns:
    () -- No return value
]]
function ExportDialog_Logic.SetVisible(Visible: boolean): ()
	AppState.SessionState.IsExportDialogVisible = Visible
end

