----------------------------------------------------------
-- Public APIs Section
----------------------------------------------------------

--[[
Toggles the visibility state of the import dialog in AppState.

Returns:
    () -- No return value
]]
function ImportDialog_Logic.ToggleVisibility(): ()
	AppState.SessionState.IsImportDialogVisible = not AppState.SessionState.IsImportDialogVisible
end

--[[
Explicitly sets the visibility state of the import dialog in AppState.

Params:
    Visible: boolean -- Whether the dialog should be visible

Returns:
    () -- No return value
]]
function ImportDialog_Logic.SetVisible(Visible: boolean): ()
	AppState.SessionState.IsImportDialogVisible = Visible
end

----------------------------------------------------------
return ImportDialog_Logic :: ImportDialog_Logic
